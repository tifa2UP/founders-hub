# Resend API key — get one at https://resend.com/api-keys
RESEND_API_KEY=

# Comma-separated list of email addresses that receive new applications.
# No spaces around commas.
APPLICATION_RECIPIENTS=

# Sender address. Until a custom domain is verified in Resend, use:
#   Founders Hub <onboarding@resend.dev>
# Once founder-hub.com is verified, swap to:
#   Founders Hub <andreas@founder-hub.com>
APPLICATION_FROM_EMAIL="Founders Hub <onboarding@resend.dev>"
